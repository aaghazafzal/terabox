# TeraBox Cloud Resolver Environment Configuration
PORT=3000

# Your TeraBox account cookie (ndus=...)
# Get this from browser DevTools -> Application -> Cookies -> terabox.com -> ndus
TERABOX_COOKIE="ndus=YOUR_NDUS_COOKIE_HERE; lang=en; PANWEB=1"

# Target Cloudflare Worker for proxying video segments and caching full streams
WORKER_URL="https://terabox-player-api.cinemahubapi.workers.dev"

# Cache TTL in seconds (default: 4 hours = 14400s)
CACHE_TTL_SECONDS=14400
